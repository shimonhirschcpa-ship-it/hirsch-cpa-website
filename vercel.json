{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "hirsch-cpa-website.vercel.app" }],
      "destination": "https://www.hirsch.cpa/$1",
      "permanent": true
    },
    { "source": "/index", "destination": "/", "permanent": true }
  ]
}
